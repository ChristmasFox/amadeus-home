# Copy to .env for local tooling only. Never commit .env.
NODE_ENV=development
TZ=Asia/Shanghai

# Agent runtime
PUBG_QUERY_ENGINE_PORT=5310
PUBG_QUERY_ENGINE_HOST=127.0.0.1
PUBG_N8N_DATA_URL=http://127.0.0.1:5679/webhook/pubg-data-gateway-v3
PUBG_N8N_TIMEOUT_MS=120000
PUBG_STATE_FILE=./.local/state.json
PUBG_FEATURE_STATE_FILE=./.local/features.json
PUBG_SELECTION_STATE_FILE=./.local/selections.json
PUBG_TIMEZONE=Asia/Shanghai
PUBG_BUSINESS_DAY_START=06:00
PUBG_RESULTSET_TTL_MS=86400000
PUBG_CONTEXT_TTL_MS=43200000
PUBG_PLANNER_MODEL=
PUBG_TELEMETRY_URL=
PUBG_TELEMETRY_TIMEOUT_MS=120000
PUBG_TELEMETRY_PARSER_VERSION=telemetry-parser-4
PUBG_REVIEW_FEATURE_VERSION=review-features-4
# Optional local-only telemetry fixture for inspect_* scripts; never commit the archive.
PUBG_REAL_MATCH_FIXTURE=
# Prefer a mounted secret file in deployment. Keep this empty locally.
PUBG_API_KEY=
PUBG_API_KEY_FILE=

# LangBot / n8n endpoints. Credentials are restored out-of-band.
LANGBOT_IMAGE=rockchin/langbot:latest
LANGBOT_ENV_FILE=/DATA/AppData/langbot/.env
LANGBOT_DATA_DIR=/DATA/AppData/langbot/data
LANGBOT_SECRETS_DIR=/DATA/AppData/langbot/secrets
PUBG_RUNTIME_IMAGE=local/pubg-query-engine-v3:latest
N8N_ENV_FILE=/DATA/AppData/n8n/.env
N8N_PUBLIC_PORT=5679
N8N_HOST=0.0.0.0
N8N_PUBLIC_BASE_URL=http://localhost:5679/
N8N_WEBHOOK_URL=http://localhost:5679/

# Optional Cloudflare Tunnel values. Store real values outside Git.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_CREDENTIALS_FILE=

# HomeLab templates
ARIA2_RPC_SECRET=
NINE_ROUTER_JWT_SECRET=
NINE_ROUTER_INITIAL_PASSWORD=
NINE_ROUTER_API_KEY_SECRET=
NINE_ROUTER_MACHINE_ID_SALT=

# Copy to .env for local tooling only. Never commit .env.
NODE_ENV=development
TZ=Asia/Shanghai

# Agent runtime
PUBG_QUERY_ENGINE_PORT=5310
PUBG_QUERY_ENGINE_HOST=127.0.0.1
PUBG_N8N_DATA_URL=http://127.0.0.1:5679/webhook/pubg-data-gateway-v3
PUBG_N8N_TIMEOUT_MS=120000
PUBG_STATE_FILE=./.local/state.json
PUBG_FEATURE_STATE_FILE=./.local/features.json
PUBG_SELECTION_STATE_FILE=./.local/selections.json
PUBG_TIMEZONE=Asia/Shanghai
PUBG_BUSINESS_DAY_START=06:00
PUBG_RESULTSET_TTL_MS=86400000
PUBG_CONTEXT_TTL_MS=43200000
PUBG_PLANNER_MODEL=
PUBG_TELEMETRY_URL=
PUBG_TELEMETRY_TIMEOUT_MS=120000
PUBG_TELEMETRY_PARSER_VERSION=telemetry-parser-4
PUBG_REVIEW_FEATURE_VERSION=review-features-4
# Optional local-only telemetry fixture for inspect_* scripts; never commit the archive.
PUBG_REAL_MATCH_FIXTURE=
# Prefer a mounted secret file in deployment. Keep this empty locally.
PUBG_API_KEY=
PUBG_API_KEY_FILE=

# Read-only administrator identity mapping. These are platform user IDs, not names.
# Keep real values in the ignored local .env or external deployment environment.
TELEGRAM_ADMIN_USER_ID=
KOOK_ADMIN_USER_ID=

# Product Radar (standalone runtime; keep API keys and recipient values outside Git)
PRODUCT_RADAR_PORT=5315
PRODUCT_RADAR_HOST=127.0.0.1
PRODUCT_RADAR_DATABASE_PATH=./.local/product-radar.sqlite
PRODUCT_RADAR_WEBHOOK_URL=http://127.0.0.1:5315/api/sensors/changedetection/webhook
PRODUCT_RADAR_API_KEY=
PRODUCT_RADAR_OUTBOX_RETRY_SECONDS=60
CHANGEDETECTION_BASE_URL=http://127.0.0.1:5000
CHANGEDETECTION_API_KEY=
PRODUCT_RADAR_LANGBOT_API_TOKEN_FILE=
PRODUCT_RADAR_LANGBOT_API_TOKEN_HOST_FILE=
PRODUCT_RADAR_TELEGRAM_BOT_ID=
PRODUCT_RADAR_KOOK_BOT_ID=
BUNJANG_API_BASE_URL=https://api.bunjang.co.kr
BUNJANG_WEB_BASE_URL=https://m.bunjang.co.kr

# LangBot / n8n endpoints. Credentials are restored out-of-band.
# Internal shared Authorization endpoint used by the organize-emby plugin.
HOMEHUB_AUTH_URL=http://pubg-query-engine-v3:5310
LANGBOT_IMAGE=rockchin/langbot:latest
LANGBOT_ENV_FILE=/DATA/AppData/langbot/.env
LANGBOT_DATA_DIR=/DATA/AppData/langbot/data
LANGBOT_SECRETS_DIR=/DATA/AppData/langbot/secrets
PUBG_RUNTIME_IMAGE=local/pubg-query-engine-v3:latest
N8N_ENV_FILE=/DATA/AppData/n8n/.env
N8N_PUBLIC_PORT=5679
N8N_HOST=0.0.0.0
N8N_PUBLIC_BASE_URL=http://localhost:5679/
N8N_WEBHOOK_URL=http://localhost:5679/

# Read-only macOS HostAgent endpoint. Token file is restored outside Git.
MAC_HOST_AGENT_URL=http://host.docker.internal:49152
MAC_HOST_AGENT_TOKEN_FILE=/DATA/AppData/pubg-query-engine-v3/secrets/mac-host-agent-token

# HomeHub Docker API socket (runtime compose only; group ID must match the host socket).
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_SOCKET_GID=104

# Optional Cloudflare Tunnel values. Store real values outside Git.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_CREDENTIALS_FILE=

# HomeLab templates
ARIA2_RPC_SECRET=
NINE_ROUTER_JWT_SECRET=
NINE_ROUTER_INITIAL_PASSWORD=
NINE_ROUTER_API_KEY_SECRET=
NINE_ROUTER_MACHINE_ID_SALT=

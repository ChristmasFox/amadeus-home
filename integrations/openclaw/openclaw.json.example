{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token"
    },
    "trustedProxies": ["127.0.0.1", "172.24.0.1"],
    "publicOrigin": "https://claw.nyannyan.top",
    "controlUi": {
      "enabled": true,
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789",
        "http://host.docker.internal:18789",
        "https://claw.nyannyan.top"
      ]
    }
  },
  "session": {
    "dmScope": "per-account-channel-peer",
    "groupScope": "per-group"
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "model": {
        "primary": "nine_router/arthur-combo"
      },
      "userTimezone": "Asia/Shanghai",
      "timeoutSeconds": 300
    }
  },
  "models": {
    "mode": "replace",
    "providers": {
      "nine_router": {
        "baseUrl": "http://9router:20128/v1",
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "OPENCLAW_9ROUTER_API_KEY"
        },
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "arthur-combo",
            "name": "arthur-combo",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 1000000,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "sessions": {
      "visibility": "self"
    },
    "toolsBySender": {
      "*": {
        "allow": ["web_search", "web_fetch"]
      }
    }
  },
  "plugins": {
    "enabled": true,
    "allow": ["pubg", "amadeus", "whatsapp", "telegram"],
    "entries": {
      "pubg": {
        "enabled": true,
        "config": {
          "databasePath": "/data/pubg.sqlite",
          "teamConfigFile": "/run/secrets/pubg_team.json",
          "apiKeyFile": "/run/secrets/pubg_api_key",
          "identityDatabasePath": "/data/identity.sqlite",
          "identityPresetsFile": "/data/identity-presets.json",
          "apiBaseUrl": "https://api.pubg.com",
          "timezone": "Asia/Shanghai",
          "businessDayStart": "06:00",
          "maxMatches": 500,
          "freshnessMs": 300000
        }
      },
      "whatsapp": {
        "enabled": true
      },
      "amadeus": {
        "enabled": true,
        "config": {
          "productRadarBaseUrl": "http://product-radar:5315",
          "mediaAdapterBaseUrl": "http://media-organizer-adapter:8765",
          "macSshHost": "host.docker.internal",
          "macSshKeyFile": "/run/secrets/mac_ssh_key",
          "kookApiBaseUrl": "https://www.kookapp.cn/api/v3",
          "kookTokenFile": "/run/secrets/kook_bot_token",
          "ownerTargetFile": "/run/secrets/owner_whatsapp_target",
          "ownerWhatsappAccountId": "secondary",
          "notificationOutboxDir": "/var/lib/openclaw/notifications",
          "identityDatabasePath": "/data/identity.sqlite",
          "identityPresetsFile": "/data/identity-presets.json",
          "marketDataBaseUrl": "https://query2.finance.yahoo.com/v8/finance/chart",
          "kiwiVmBaseUrl": "https://api.64clouds.com/v1",
          "kiwiVmCredentialsFile": "/run/secrets/kiwivm_credentials.json",
          "vpsSshKeyFile": "/run/secrets/vps_ssh_key",
          "vpsSshKnownHostsFile": "/run/secrets/vps_ssh_known_hosts",
          "vpsUsageStateFile": "/data/vps-usage-state.json"
        }
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "tokenFile": "/run/secrets/telegram_bot_token",
      "dmPolicy": "allowlist",
      "allowFrom": [],
      "groupPolicy": "open",
      "groups": {
        "*": {
          "requireMention": false
        }
      },
      "streaming": {
        "mode": "off"
      },
      "configWrites": false,
      "commands": {
        "native": false,
        "nativeSkills": false
      }
    },
    "whatsapp": {
      "enabled": true,
      "defaultAccount": "secondary",
      "accounts": {
        "secondary": {
          "enabled": true
        }
      },
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "groupPolicy": "open",
      "groups": {
        "*": {
          "requireMention": false
        }
      },
      "configWrites": false
    }
  }
}

# LangBot configuration keys only. Keep all values empty or replace out-of-band.
TZ=Asia/Shanghai
LANGBOT_PORT=5300
LANGBOT_DATA_DIR=/DATA/AppData/langbot/data

# Platform credentials: restore from a password manager, never from Git.
TELEGRAM_BOT_TOKEN=
KOOK_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Model and service credentials.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DIFY_API_KEY=
N8N_WEBHOOK_URL=
N8N_AUTH_TOKEN=

# Optional SSH secret file path on the target host.
LANGBOT_SSH_KEY_FILE=

# Product Radar plugin. Keep API key empty or restore it out-of-band.
PRODUCT_RADAR_URL=http://product-radar:5315
PRODUCT_RADAR_API_KEY=

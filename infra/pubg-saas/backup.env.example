# Install as a mode-0600 file outside Git at /etc/pubg-saas/backup.env.
PUBG_SAAS_DATABASE_URL=postgresql://pubg_backup:replace-me@127.0.0.1:55433/pubg_saas?sslmode=disable
PUBG_SAAS_BACKUP_RECIPIENTS_FILE=/etc/pubg-saas/age-recipients.txt
PUBG_SAAS_BACKUP_OUTPUT_DIR=/path/to/independent-encrypted-storage/pubg-saas
PUBG_SAAS_BACKUP_RETENTION_DAYS=7

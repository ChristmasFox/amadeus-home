<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.amadeus.krea2-image</string>
  <key>ProgramArguments</key><array><string>__PYTHON__</string><string>__SERVICE_SCRIPT__</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>AMADEUS_KREA2_ENGINE_CONFIG</key><string>__ENGINE_CONFIG__</string>
    <key>AMADEUS_KREA2_TOKEN_FILE</key><string>__TOKEN_FILE__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/bridge.stdout.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/bridge.stderr.log</string>
</dict></plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.amadeus.kurisu-gpt-sovits-tts</string>
  <key>ProgramArguments</key><array><string>__PYTHON__</string><string>__ADAPTER_SCRIPT__</string></array>
  <key>WorkingDirectory</key><string>__POC_ROOT__</string>
  <key>EnvironmentVariables</key><dict>
    <key>AMADEUS_GPT_SOVITS_TTS_BIND</key><string>127.0.0.1</string>
    <key>AMADEUS_GPT_SOVITS_TTS_PORT</key><string>19871</string>
    <key>AMADEUS_GPT_SOVITS_TTS_TOKEN_FILE</key><string>__TOKEN_FILE__</string>
    <key>AMADEUS_GPT_SOVITS_REFERENCE_AUDIO</key><string>__REFERENCE_AUDIO__</string>
  <key>AMADEUS_GPT_SOVITS_PROMPT_TEXT</key><string>そして世界はパラレルワールドとしてここではマユリが助からなかった未来が</string>
    <key>AMADEUS_GPT_SOVITS_UPSTREAM_URL</key><string>http://127.0.0.1:19870/tts</string>
    <key>AMADEUS_GPT_SOVITS_FFMPEG</key><string>__FFMPEG__</string>
    <key>AMADEUS_GPT_SOVITS_TIMEOUT_SECONDS</key><string>55</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__LOG_DIR__/kurisu-gpt-sovits-tts.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/kurisu-gpt-sovits-tts.err.log</string>
</dict></plist>

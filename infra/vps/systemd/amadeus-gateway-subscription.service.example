[Unit]
Description=Amadeus Gateway dynamic subscription responder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/var/lib/amadeus-gateway
EnvironmentFile=-/etc/amadeus-gateway/subscription.env
ExecStart=/usr/bin/python3 /usr/local/libexec/amadeus_gateway_subscription.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/amadeus-gateway
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

[Unit]
Description=Amadeus VPS daily traffic fuse reconciliation
After=network-online.target amadeus-gateway-accounting.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/libexec/amadeus-vps-traffic-fuse
ExecStart=/usr/bin/python3 /usr/local/libexec/amadeus-vps-traffic-fuse/traffic_fuse.py --config /etc/amadeus/traffic-fuse.json tick
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/amadeus-traffic-fuse
ReadOnlyPaths=/usr/local/libexec/amadeus-vps-traffic-fuse /etc/amadeus/traffic-fuse.json
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
RestrictSUIDSGID=true
MemoryMax=64M
CPUQuota=10%
TasksMax=8

{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-reality-in",
      "listen": "0.0.0.0",
      "port": 2053,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "<LABMEM001_UUID>",
            "email": "Labmem001.vless",
            "level": 0,
            "flow": "xtls-rprx-vision"
          },
          {
            "id": "<LABMEM002_UUID>",
            "email": "Labmem002.vless",
            "level": 0,
            "flow": "xtls-rprx-vision"
          },
          {
            "id": "<LABMEM003_UUID>",
            "email": "Labmem003.vless",
            "level": 0,
            "flow": "xtls-rprx-vision"
          },
          {
            "id": "<LABMEM004_UUID>",
            "email": "Labmem004.vless",
            "level": 0,
            "flow": "xtls-rprx-vision"
          },
          {
            "id": "<LABMEM005_UUID>",
            "email": "Labmem005.vless",
            "level": 0,
            "flow": "xtls-rprx-vision"
          },
          {
            "id": "<M204_NET_CORE_UUID>",
            "email": "M204-Net-Core.vless",
            "level": 0,
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "127.0.0.1:24431",
          "xver": 0,
          "serverNames": [
            "example.com"
          ],
          "privateKey": "<REALITY_PRIVATE_KEY_ONLY_ON_VPS>",
          "shortIds": [
            "<16_HEX_SHORT_ID>"
          ]
        }
      }
    },
    {
      "tag": "reality-fallback-gate",
      "listen": "127.0.0.1",
      "port": 24431,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "www.apple.com",
        "port": 443,
        "network": "tcp"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["tls"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "stats": {},
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["reality-fallback-gate"],
        "domain": ["full:www.apple.com"],
        "outboundTag": "direct",
        "ruleTag": "reality-fallback-allow-exact-sni"
      },
      {
        "type": "field",
        "inboundTag": ["reality-fallback-gate"],
        "outboundTag": "block",
        "ruleTag": "reality-fallback-block-other"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true,
        "statsUserOnline": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "api": {
    "tag": "api",
    "listen": "127.0.0.1:10085",
    "services": ["StatsService"]
  }
}

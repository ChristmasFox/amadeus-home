# Runtime-only settings for amadeus-gateway-subscription.service.
# Keep the actual KiwiVM credentials in the external JSON file below.
SUBSCRIPTION_ROOT=/var/lib/caddy/subscription
SUBSCRIPTION_FILENAME=amadeus-gateway
SUBSCRIPTION_LISTEN_HOST=127.0.0.1
SUBSCRIPTION_LISTEN_PORT=8787
KIWIVM_BASE_URL=https://api.64clouds.com/v1
KIWIVM_CREDENTIALS_FILE=/etc/amadeus-gateway/kiwivm-credentials.json
USAGE_STATE_FILE=/var/lib/amadeus-gateway/usage-state.json
USAGE_CACHE_SECONDS=60

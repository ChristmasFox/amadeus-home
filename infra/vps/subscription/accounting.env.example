# Non-secret accounting service settings. Runtime secret values are read from
# protected files and must never be added here or committed.
ACCOUNTING_DB_PATH=/var/lib/amadeus-accounting/subscription-accounts.sqlite
ACCOUNTING_PUBLIC_SNAPSHOT_PATH=/var/lib/amadeus-accounting/subscription-usage-public.json
ACCOUNTING_SNAPSHOT_GROUP=amadeus-accounting-snapshot
ACCOUNTING_LISTEN_HOST=127.0.0.1
ACCOUNTING_LISTEN_PORT=18796
ACCOUNTING_SAMPLE_INTERVAL_SECONDS=60
# Start false so auth is available before protocol cutovers; enable only after
# HY2 and Xray stats are both healthy, immediately before capturing T0.
ACCOUNTING_COLLECTOR_ENABLED=true

# Bounded HY2 failed-auth telemetry and conservative source throttling. Keep
# telemetry mode for the first deployment; switch to enforce only after real
# clients pass retry/compatibility smokes. Limiter state is memory-only.
HY2_AUTH_FAIL_MODE=telemetry
HY2_AUTH_FAIL_WINDOW_SECONDS=900
HY2_AUTH_FAIL_THRESHOLD=120
HY2_AUTH_FAIL_COOLDOWN_SECONDS=300
HY2_AUTH_FAIL_MAX_TRACKED_SOURCES=4096

# Owner-only suspicious-signal thresholds; signals never revoke valid users.
REALITY_FALLBACK_ALERT_BYTES=1024
ACCOUNT_DOMINANT_SHARE_PERCENT=85
ACCOUNT_DOMINANT_MIN_WINDOW_BYTES=1073741824

HY2_STATS_URL=http://127.0.0.1:19999
HY2_STATS_SECRET_FILE=/etc/amadeus-accounting/hysteria-stats-secret
XRAY_STATS_SERVER=127.0.0.1:10085
XRAY_BINARY=/usr/local/bin/xray
KIWIVM_BASE_URL=https://api.64clouds.com/v1
KIWIVM_CREDENTIALS_FILE=/etc/amadeus-accounting/kiwivm-credentials.json

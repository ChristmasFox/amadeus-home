# Copy to infra/host-profile.env for machine-specific non-secret overrides.
# Secrets remain in CasaOS/OpenClaw secret files and external env files.
ORBSTACK_MACHINE=ubuntu
OPENCLAW_APP_DIR=/var/lib/casaos/apps/openclaw
OPENCLAW_DATA_DIR=/DATA/AppData/openclaw
RADAR_APP_DIR=/var/lib/casaos/apps/product-radar
RADAR_DATA_DIR=/DATA/AppData/product-radar
AMADEUS_NETWORK_NAME=amadeus_network
NINE_ROUTER_NETWORK_NAME=9router_default
NINE_ROUTER_IMAGE=local/9router:0.5.81
MEDIA_ADAPTER_APP_DIR=/var/lib/casaos/apps/media-organizer-adapter
MEDIA_ADAPTER_CONTAINER=media-organizer-adapter
MAC_CONTROL_HOST=host.docker.internal
# Set this to the macOS account that owns the SSH key; the helper defaults to id -un.
MAC_CONTROL_USER=
MAC_CONTROL_KEY_HOST_FILE=/DATA/AppData/openclaw/secrets/mac-ssh-key
HOME_LAB_HOST=http://host.docker.internal
HOME_LAB_BASE_URL=http://host.docker.internal
HOME_LAB_GLANCES_URL=http://host.docker.internal:61208/api/4/quicklook
HOME_LAB_UPTIME_URL=http://host.docker.internal:61208/api/4/uptime
CONTROL_UI_LAN_ORIGIN=http://host.docker.internal:18789
CODEX_NOTIFY_HOOK_PATH=
CODEX_NOTIFY_BACKUP_ROOT=
FASHION_SIGLIP_LABEL=com.productradar.fashion-siglip
FASHION_SIGLIP_PORT=18400
FASHION_SIGLIP_INSTALL_DIR=
FASHION_SIGLIP_MODEL_CACHE_DIR=
FASHION_SIGLIP_MODEL_CACHE_POLICY=redownload
EXTERNAL_STORAGE_ROOT=/Volumes/Avalon
# Fill from `diskutil info /Volumes/Avalon`; do not guess this value.
EXTERNAL_STORAGE_VOLUME_UUID=
EXTERNAL_STORAGE_SENTINEL_ID=avalon-primary-8tb
IMMICH_MEDIA_ROOT=/Volumes/Avalon/immich/data
IMMICH_ENV_FILE=/DATA/AppData/immich/immich.env
NINE_ROUTER_ENV_FILE=/DATA/AppData/9router/9router.env
SKULD_BACKUP_ROOT=/Volumes/Avalon/backups/operation-skuld
STORAGE_WARN_FREE_PERCENT=20
STORAGE_CRITICAL_FREE_PERCENT=10
STORAGE_WARN_FREE_BYTES=
STORAGE_CRITICAL_FREE_BYTES=
STORAGE_SAFETY_MARGIN_BYTES=10737418240
STORAGE_MEANINGFUL_RELEASE_BYTES=1073741824
STORAGE_GROWTH_HISTORY_RETENTION_DAYS=90
STORAGE_HARD_MIN_FREE_BYTES=10737418240
STORAGE_READINESS_ALLOW_KNOWN_PRESSURE=0
DOCKER_LOG_DRIVER=local
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
DOCKER_BUILD_CACHE_RETENTION_HOURS=168
DEPLOYMENT_IMAGE_RETENTION_COUNT=2
DEPLOYMENT_CHECKPOINT_RETENTION_COUNT=3
# Set one of these outside Git for the encrypted secret export.
SKULD_SECRET_RECIPIENT=
SKULD_SECRET_PASSPHRASE_FILE=

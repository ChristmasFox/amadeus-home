{
  "name": "@agent/pubg-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "evaluation:replay": "tsx scripts/replay-benchmark.ts",
    "telemetry:backfill": "tsx scripts/backfill-raw-telemetry.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./gate": {
      "types": "./dist/src/gate.d.ts",
      "import": "./dist/src/gate.js",
      "default": "./dist/src/gate.js"
    },
    "./archive": {
      "types": "./dist/src/raw-telemetry-archive.d.ts",
      "import": "./dist/src/raw-telemetry-archive.js",
      "default": "./dist/src/raw-telemetry-archive.js"
    },
    "./backfill": {
      "types": "./dist/src/raw-telemetry-backfill.d.ts",
      "import": "./dist/src/raw-telemetry-backfill.js",
      "default": "./dist/src/raw-telemetry-backfill.js"
    }
  },
  "dependencies": {
    "@agent/pubg-domain": "workspace:*",
    "ai": "7.0.137",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  }
}

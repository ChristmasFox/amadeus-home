{
  "name": "@agent/product-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --import tsx/esm src/index.ts",
    "start": "node dist/src/index.js",
    "smoke:bunjang": "tsx scripts/smoke-bunjang.ts",
    "smoke:similarity": "tsx scripts/smoke-similarity.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "sharp": "0.35.4"
  }
}

{
  "name": "@agent/pubg-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/infrastructure/postgres/migrations dist/src/application && cp src/infrastructure/postgres/migrations/*.sql dist/src/infrastructure/postgres/migrations/ && cp src/application/public-agent-soul.md dist/src/application/public-agent-soul.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "worker": "node dist/src/public-sync-worker.js"
  },
  "dependencies": {
    "@rine-kit/agent-memory": "0.1.5",
    "@rine-kit/presentation": "0.1.5",
    "@rine-kit/pubg-domain": "0.1.5",
    "@ai-sdk/openai-compatible": "3.0.67",
    "ai": "7.0.137",
    "pg": "^8.23.1",
    "undici": "8.10.2",
    "zod": "4.5.4",
    "@rine-kit/pubg-intelligence": "0.1.5"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "4.23.13",
    "typescript": "5.9.2"
  }
}

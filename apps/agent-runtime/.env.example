PUBG_QUERY_ENGINE_PORT=5310
PUBG_QUERY_ENGINE_HOST=0.0.0.0
PUBG_N8N_DATA_URL=http://n8n:5678/webhook/pubg-data-gateway-v3
PUBG_N8N_TIMEOUT_MS=120000
PUBG_STATE_FILE=/data/state.json
PUBG_TIMEZONE=Asia/Shanghai
PUBG_BUSINESS_DAY_START=06:00
PUBG_RESULTSET_TTL_MS=86400000
PUBG_CONTEXT_TTL_MS=43200000
PUBG_FEATURE_STATE_FILE=/data/features.json
PUBG_SELECTION_STATE_FILE=/data/selections.json
PUBG_PLANNER_MODEL=
# Set either a private n8n telemetry webhook URL or PUBG_API_KEY_FILE.
# The key is loaded from deployment secrets; never commit it to this file.
PUBG_TELEMETRY_URL=
PUBG_API_KEY=
PUBG_API_KEY_FILE=/run/secrets/pubg_api_key
TELEGRAM_ADMIN_USER_ID=
KOOK_ADMIN_USER_ID=
PUBG_TELEMETRY_TIMEOUT_MS=120000
PUBG_TELEMETRY_PARSER_VERSION=telemetry-parser-4
PUBG_REVIEW_FEATURE_VERSION=review-features-4

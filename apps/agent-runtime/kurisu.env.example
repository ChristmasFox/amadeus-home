# Kurisu P6 release-preparation template. Keep all values empty or external;
# this file is never a source for production secrets.
KURISU_STATE_FILE=/data/state.json.kurisu.sqlite
KURISU_GATEWAY_SECRET_FILE=/run/secrets/kurisu_gateway_secret
KURISU_NOTIFICATIONS_ENABLE=0
KURISU_NOTIFICATION_POLL_MS=5000
KURISU_NOTIFICATION_SECRET_FILE=/run/secrets/kurisu-notification-secret
KURISU_NOTIFICATION_PRINCIPAL_KEY=telegram:admin
KURISU_NOTIFICATION_LANGBOT_URL=http://langbot:5300
KURISU_NOTIFICATION_LANGBOT_HEADER=Authorization
KURISU_NOTIFICATION_LANGBOT_API_KEY_FILE=/run/secrets/langbot-api-key
KURISU_NOTIFICATION_TELEGRAM_RECIPIENT=
KURISU_NOTIFICATION_TELEGRAM_BOT_ID=
KURISU_NOTIFICATION_KOOK_RECIPIENT=
KURISU_NOTIFICATION_KOOK_BOT_ID=

# Codex is disabled by default. Enable only with a server-owned absolute
# project root and worktree parent; never pass an arbitrary model path or cwd.
KURISU_CODEX_ENABLE=0
KURISU_CODEX_PROJECT_ID=agent-monorepo
KURISU_CODEX_PROJECT_ROOT=
KURISU_CODEX_WORKTREE_ROOT=
KURISU_CODEX_MODEL=

# Writes are disabled until the separately authorized P7 rollout.
KURISU_ENABLE_WRITE_TOOLS=0
KURISU_RADAR_URL=http://product-radar:5315
KURISU_RADAR_API_KEY=
KURISU_RADAR_TIMEOUT_MS=5000
KURISU_MEDIA_DOWNLOADS_ROOT=/Volumes/Avalon/downloads
KURISU_MEDIA_MOVIES_ROOT=/Volumes/Avalon/media/movies
KURISU_MEDIA_TV_ROOT=/Volumes/Avalon/media/tv

# Product Radar remains its local notification owner until P7 handoff.
PRODUCT_RADAR_NOTIFICATION_OWNER=local
PRODUCT_RADAR_KURISU_NOTIFICATION_URL=http://pubg-query-engine-v3:5310/kurisu/notifications/events
PRODUCT_RADAR_KURISU_NOTIFICATION_SECRET_FILE=/run/secrets/kurisu-notification-secret
PRODUCT_RADAR_KURISU_PRINCIPAL_KEY=telegram:admin

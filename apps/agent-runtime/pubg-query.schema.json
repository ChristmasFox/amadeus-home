{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pubg-query-engine-v3",
  "title": "PUBG Query Engine V3 Canonical Query",
  "type": "object",
  "required": ["version", "queryId", "domain", "subject", "operation", "selector", "segments", "groupBy", "metrics", "filters", "orderBy", "limit", "reference", "presentation"],
  "properties": {
    "version": { "const": 3 },
    "queryId": { "type": "string", "minLength": 1 },
    "domain": { "const": "pubg" },
    "subject": { "type": "object", "required": ["type", "ids"], "properties": { "type": { "enum": ["team", "player", "players"] }, "ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "label": { "type": "string" } }, "additionalProperties": false },
    "operation": { "enum": ["report", "detail", "rank", "strongest", "weakest", "compare", "trend", "list", "review_match"] },
    "selector": { "oneOf": [{ "$ref": "#/$defs/timeRange" }, { "$ref": "#/$defs/relative" }, { "$ref": "#/$defs/recentDays" }, { "$ref": "#/$defs/lastN" }, { "$ref": "#/$defs/resultSet" }] },
    "matchSelector": { "oneOf": [{ "$ref": "#/$defs/matchSelector" }, { "type": "null" }] },
    "segments": { "type": "array", "items": { "type": "object", "required": ["label", "selector"], "properties": { "label": { "type": "string" }, "selector": { "$ref": "#/properties/selector" } }, "additionalProperties": false } },
    "groupBy": { "enum": ["player", "match", "day", "team"] },
    "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metric" } },
    "filters": { "type": "object" },
    "orderBy": { "type": "object", "required": ["metric", "direction"], "properties": { "metric": { "$ref": "#/$defs/metric" }, "direction": { "enum": ["asc", "desc"] } }, "additionalProperties": false },
    "limit": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000 },
    "reference": { "type": "object", "properties": { "sessionId": { "type": "string" } } },
    "presentation": { "type": "object", "properties": { "periodLabel": { "type": "string" }, "renderer": { "type": "string" }, "profile": { "enum": ["default", "combat", "weapon", "vehicle", "personal", "fun", "detailed"] }, "compact": { "type": "boolean" } } }
  },
  "$defs": {
    "metric": { "enum": ["matches", "kills", "assists", "damage", "avg_damage", "kd", "deaths", "wins", "top10", "rank", "dbnos", "revives", "headshot_kills", "survival_time", "longest_kill", "performance_score", "chicken_index"] },
    "timeRange": { "type": "object", "required": ["type", "start", "end"], "properties": { "type": { "const": "time_range" }, "start": { "type": "string" }, "end": { "type": "string" }, "label": { "type": "string" }, "timezone": { "type": "string" }, "businessDayStart": { "type": "string" } }, "additionalProperties": false },
    "relative": { "type": "object", "required": ["type", "value"], "properties": { "type": { "const": "relative_period" }, "value": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false },
    "recentDays": { "type": "object", "required": ["type", "count"], "properties": { "type": { "const": "recent_days" }, "count": { "type": "integer", "minimum": 1, "maximum": 366 }, "label": { "type": "string" } }, "additionalProperties": false },
    "lastN": { "type": "object", "required": ["type", "count"], "properties": { "type": { "const": "last_n_matches" }, "count": { "type": "integer", "minimum": 1, "maximum": 1000 }, "offset": { "type": "integer", "minimum": 0 }, "label": { "type": "string" } }, "additionalProperties": false },
    "resultSet": { "type": "object", "required": ["type", "resultSetId"], "properties": { "type": { "const": "result_set" }, "resultSetId": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false },
    "matchSelector": { "oneOf": [
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "latest" }, "recent": { "type": "boolean" } }, "additionalProperties": false },
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "earliest" } }, "additionalProperties": false },
      { "type": "object", "required": ["type", "ordinal"], "properties": { "type": { "const": "ordinal" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 1000 } }, "additionalProperties": false },
      { "type": "object", "required": ["type", "ordinal"], "properties": { "type": { "const": "ordinal_from_end" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 1000 } }, "additionalProperties": false },
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "filtered" }, "filters": { "type": "object" } }, "additionalProperties": false },
      { "type": "object", "required": ["type", "metric", "direction"], "properties": { "type": { "const": "ranked" }, "metric": { "enum": ["teamDamage", "teamKills", "teamAssists", "placement", "duration", "damage", "kills", "assists"] }, "direction": { "enum": ["asc", "desc"] } }, "additionalProperties": false },
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "active_match" } }, "additionalProperties": false },
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "previous" } }, "additionalProperties": false },
      { "type": "object", "required": ["type"], "properties": { "type": { "const": "next" } }, "additionalProperties": false }
    ] }
  }
}
